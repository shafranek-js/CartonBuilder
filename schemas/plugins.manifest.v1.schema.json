{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cartonbuilder.dev/schemas/plugins.manifest.v1.json",
  "title": "PluginsManifestV1",
  "description": "Deterministic catalog of vendored CartonBuilder plugins",
  "type": "object",
  "required": ["manifestVersion", "description", "plugins"],
  "additionalProperties": false,
  "properties": {
    "manifestVersion": { "type": "string", "const": "plugins.manifest.v1" },
    "description": { "type": "string", "minLength": 1 },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["manifestPath", "manifestArtifact", "plugin"],
        "additionalProperties": false,
        "properties": {
          "manifestPath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![\\\\/])(?![A-Za-z]:)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
          },
          "manifestArtifact": {
            "type": "object",
            "required": ["byteLength", "sha256"],
            "additionalProperties": false,
            "properties": {
              "byteLength": { "type": "integer", "minimum": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          },
          "plugin": { "$ref": "https://cartonbuilder.dev/schemas/plugin.manifest.v1.json" }
        }
      }
    }
  }
}

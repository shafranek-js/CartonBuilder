+EXPORT
+void wasm_convert_cmyk_buffer_to_rgb(int width, int height, unsigned char *cmyk, unsigned char *rgb)
+{
+	fz_pixmap *src = NULL;
+	fz_pixmap *dst = NULL;
+	fz_var(src);
+	fz_var(dst);
+	fz_try(ctx)
+	{
+		src = fz_new_pixmap_with_bbox(ctx, fz_device_cmyk(ctx), fz_make_irect(0, 0, width, height), NULL, 0);
+		memcpy(src->samples, cmyk, (size_t)width * (size_t)height * 4);
+		dst = fz_convert_pixmap(ctx, src, fz_device_rgb(ctx), NULL, NULL, fz_default_color_params, 0);
+		memcpy(rgb, dst->samples, (size_t)width * (size_t)height * 3);
+	}
+	fz_always(ctx)
+	{
+		fz_drop_pixmap(ctx, src);
+		fz_drop_pixmap(ctx, dst);
+	}
+	fz_catch(ctx)
+	{
+		wasm_rethrow(ctx);
+	}
+}

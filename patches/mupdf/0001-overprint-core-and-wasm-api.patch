+EXPORT
+fz_pixmap * wasm_pdf_new_pixmap_from_page_with_usage_and_overprint_behaviors(pdf_page *page, fz_matrix *ctm, fz_colorspace *colorspace, boolean alpha, char *usage, int box, int overprint_mode, int *behaviors, int nbehaviors)
+{
+	fz_separations *seps = NULL;
+	fz_pixmap *pix = NULL;
+	fz_var(seps);
+	fz_var(pix);
+	fz_try(ctx)
+	{
+		seps = pdf_page_separations(ctx, page);
+		if (seps)
+		{
+			int i, n = fz_count_separations(ctx, seps);
+			for (i = 0; i < n; i++)
+			{
+				int behavior = (i < nbehaviors) ? behaviors[i] : FZ_SEPARATION_COMPOSITE;
+				fz_set_separation_behavior(ctx, seps, i, behavior);
+			}
+		}
+		if (overprint_mode > 0 && !seps)
+		{
+			seps = fz_new_separations(ctx, 0);
+		}
+		pix = pdf_new_pixmap_from_page_with_separations_and_usage(ctx, page, *ctm, colorspace, seps, alpha, usage, box);
+	}
+	fz_always(ctx)
+	{
+		fz_drop_separations(ctx, seps);
+	}
+	fz_catch(ctx)
+	{
+		fz_drop_pixmap(ctx, pix);
+		wasm_rethrow(ctx);
+	}
+	return pix;
+}

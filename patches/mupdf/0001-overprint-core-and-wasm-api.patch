+EXPORT
+void wasm_pdf_page_separation_coverage(pdf_page *page, int *out, int outlen, int overprint_mode)
+{
+	fz_separations *seps = NULL;
+	fz_pixmap *pix = NULL;
+	fz_try(ctx)
+	{
+		seps = pdf_page_separations(ctx, page);
+		if (seps)
+		{
+			int i, n = fz_count_separations(ctx, seps);
+			for (i = 0; i < n; i++)
+			{
+				int b = FZ_SEPARATION_COMPOSITE;
+				if (overprint_mode == 2)
+					b = FZ_SEPARATION_SPOT;
+				fz_set_separation_behavior(ctx, seps, i, b);
+			}
+		}
+		else if (overprint_mode > 0 && fz_page_uses_overprint(ctx, &page->super))
+		{
+			seps = fz_new_separations(ctx, 0);
+		}
+		pix = pdf_new_pixmap_from_page_with_separations_and_usage(ctx, page, fz_identity, fz_device_cmyk(ctx), seps, 0, "Print", FZ_CROP_BOX);
+		{
+			int w = pix->w;
+			int h = pix->h;
+			int n = pix->n;
+			int spots = pix->s;
+			int i, c, x, y;
+			int process[4] = { 0, 0, 0, 0 };
+			int total = w * h;
+			unsigned char *samples = pix->samples;
+			int stride = pix->stride;
+			for (i = 0; i < outlen; i++)
+				out[i] = 0;
+			for (y = 0; y < h; y++)
+			{
+				for (x = 0; x < w; x++)
+				{
+					unsigned char *s = samples + y * stride + x * n;
+					for (c = 0; c < 4 && c < outlen; c++)
+						if (s[c] > 0)
+							process[c]++;
+					for (i = 0; i < spots && 4 + i < outlen; i++)
+						if (s[4 + i] > 0)
+							out[4 + i] += 1;
+				}
+			}
+			for (c = 0; c < 4 && c < outlen; c++)
+				out[c] = (int)((process[c] * 100 + total / 2) / total);
+			for (i = 0; i < spots && 4 + i < outlen; i++)
+				out[4 + i] = (int)((out[4 + i] * 100 + total / 2) / total);
+		}
+	}
+	fz_always(ctx)
+	{
+		fz_drop_pixmap(ctx, pix);
+		fz_drop_separations(ctx, seps);
+	}
+	fz_catch(ctx)
+	{
+		fz_drop_pixmap(ctx, pix);
+		fz_drop_separations(ctx, seps);
+		wasm_rethrow(ctx);
+	}
+}

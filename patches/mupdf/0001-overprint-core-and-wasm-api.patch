+EXPORT
+int wasm_pdf_page_separations_count(pdf_page *page)
+{
+	fz_separations *seps = NULL;
+	int n = 0;
+	fz_try(ctx)
+	{
+		seps = pdf_page_separations(ctx, page);
+		n = seps ? fz_count_separations(ctx, seps) : 0;
+	}
+	fz_always(ctx)
+	{
+		fz_drop_separations(ctx, seps);
+	}
+	fz_catch(ctx)
+	{
+		wasm_rethrow(ctx);
+	}
+	return n;
+}

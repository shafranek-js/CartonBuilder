+EXPORT
+fz_pixmap * wasm_convert_pixmap_to_rgb_with_process_mask(fz_pixmap *pix, int process_mask)
+{
+	fz_pixmap *masked = NULL;
+	fz_pixmap *converted = NULL;
+	fz_pixmap *out = NULL;
+	fz_var(masked);
+	fz_var(converted);
+	fz_var(out);
+	fz_try(ctx)
+	{
+		fz_irect bbox = fz_make_irect(pix->x, pix->y, pix->x + pix->w, pix->y + pix->h);
+		masked = fz_new_pixmap_with_bbox(ctx, pix->colorspace, bbox, pix->seps, pix->alpha);
+		masked->xres = pix->xres;
+		masked->yres = pix->yres;
+		{
+			int y, x, c, process = fz_colorspace_n(ctx, pix->colorspace);
+			memcpy(masked->samples, pix->samples, (size_t)pix->stride * (size_t)pix->h);
+			if (process > 4) process = 4;
+			for (y = 0; y < pix->h; y++)
+			{
+				unsigned char *row = masked->samples + (size_t)y * (size_t)masked->stride;
+				for (x = 0; x < pix->w; x++)
+				{
+					unsigned char *sample = row + (size_t)x * (size_t)masked->n;
+					for (c = 0; c < process; c++)
+						if ((process_mask & (1 << c)) == 0)
+							sample[c] = 0;
+				}
+			}
+		}
+		converted = fz_convert_pixmap(ctx, masked, fz_device_rgb(ctx), NULL, NULL, fz_default_color_params, 0);
+		/* fz_convert_pixmap may keep spot channels alongside RGB. The preview
+		 * protocol is RGBA, so resolve spots in MuPDF first and then expose only
+		 * RGB (+ alpha when requested), never a spot channel as fake alpha. */
+		if (converted->n == 3 + converted->alpha)
+		{
+			out = converted;
+			converted = NULL;
+		}
+		else
+		{
+			int y, x;
+			fz_irect bbox = fz_make_irect(converted->x, converted->y, converted->x + converted->w, converted->y + converted->h);
+			out = fz_new_pixmap_with_bbox(ctx, fz_device_rgb(ctx), bbox, NULL, converted->alpha);
+			for (y = 0; y < converted->h; y++)
+			{
+				unsigned char *src = converted->samples + (size_t)y * (size_t)converted->stride;
+				unsigned char *dst = out->samples + (size_t)y * (size_t)out->stride;
+				for (x = 0; x < converted->w; x++)
+				{
+					dst[0] = src[0];
+					dst[1] = src[1];
+					dst[2] = src[2];
+					if (converted->alpha)
+						dst[3] = src[converted->n - 1];
+					src += converted->n;
+					dst += out->n;
+				}
+			}
+		}
+	}
+	fz_always(ctx)
+	{
+		fz_drop_pixmap(ctx, masked);
+		fz_drop_pixmap(ctx, converted);
+	}
+	fz_catch(ctx)
+	{
+		fz_drop_pixmap(ctx, out);
+		wasm_rethrow(ctx);
+	}
+	return out;
+}

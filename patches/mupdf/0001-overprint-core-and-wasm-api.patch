+static fz_pixmap *
+wasm_render_tile(pdf_page *page, fz_matrix ctm, fz_colorspace *colorspace, boolean alpha, const char *usage, int box, int overprint_mode, int *behaviors, int nbehaviors, fz_irect bbox)
+{
+	fz_separations *seps = NULL;
+	fz_pixmap *pix = NULL;
+	fz_device *dev = NULL;
+	fz_var(seps);
+	fz_var(pix);
+	fz_var(dev);
+	fz_try(ctx)
+	{
+		seps = wasm_make_separations(page, overprint_mode, behaviors, nbehaviors);
+		pix = fz_new_pixmap_with_bbox(ctx, colorspace, bbox, seps, alpha);
+		fz_clear_pixmap(ctx, pix);
+		dev = fz_new_draw_device(ctx, ctm, pix);
+		pdf_run_page_with_usage(ctx, page, dev, fz_identity, usage, NULL);
+		fz_close_device(ctx, dev);
+	}
+	fz_always(ctx)
+	{
+		fz_drop_device(ctx, dev);
+		fz_drop_separations(ctx, seps);
+	}
+	fz_catch(ctx)
+	{
+		fz_drop_pixmap(ctx, pix);
+		wasm_rethrow(ctx);
+	}
+	return pix;
+}

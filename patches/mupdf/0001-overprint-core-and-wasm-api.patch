+EXPORT
+int wasm_page_uses_overprint(pdf_page *page)
+{
+	return fz_page_uses_overprint(ctx, &page->super);
+}
+
+static fz_pixmap *
+wasm_pdf_new_pixmap_from_page_with_usage_and_overprint_imp(pdf_page *page, fz_matrix *ctm, fz_colorspace *colorspace, boolean alpha, char *usage, int box, int overprint_mode, int contents_only)
+{
+	fz_separations *seps = NULL;
+	fz_pixmap *pix = NULL;
+	fz_var(seps);
+	fz_var(pix);
+	fz_try(ctx)
+	{
+		if (overprint_mode > 0)
+		{
+			seps = pdf_page_separations(ctx, page);
+			if (seps)
+			{
+				int i;
+				int n = fz_count_separations(ctx, seps);
+				if (overprint_mode == 2)
+					for (i = 0; i < n; i++)
+						fz_set_separation_behavior(ctx, seps, i, FZ_SEPARATION_SPOT);
+				else
+					for (i = 0; i < n; i++)
+						fz_set_separation_behavior(ctx, seps, i, FZ_SEPARATION_COMPOSITE);
+			}
+			if (!seps)
+			{
+				seps = fz_new_separations(ctx, 0);
+			}
+		}
+		if (contents_only)
+			pix = pdf_new_pixmap_from_page_contents_with_separations_and_usage(ctx, page, *ctm, colorspace, seps, alpha, usage, box);
+		else
+			pix = pdf_new_pixmap_from_page_with_separations_and_usage(ctx, page, *ctm, colorspace, seps, alpha, usage, box);
+	}
+	fz_always(ctx)
+	{
+		fz_drop_separations(ctx, seps);
+	}
+	fz_catch(ctx)
+	{
+		fz_drop_pixmap(ctx, pix);
+		wasm_rethrow(ctx);
+	}
+	return pix;
+}
+
+static fz_separations *
+wasm_make_separations(pdf_page *page, int overprint_mode, int *behaviors, int nbehaviors)
+{
+	fz_separations *seps = NULL;
+	fz_var(seps);
+	fz_try(ctx)
+	{
+		if (overprint_mode > 0)
+			seps = pdf_page_separations(ctx, page);
+		if (seps)
+		{
+			int i, n = fz_count_separations(ctx, seps);
+			for (i = 0; i < n; i++)
+			{
+				int behavior;
+				if (behaviors && i < nbehaviors)
+					behavior = behaviors[i];
+				else
+					behavior = overprint_mode == 2 ? FZ_SEPARATION_SPOT : FZ_SEPARATION_COMPOSITE;
+				fz_set_separation_behavior(ctx, seps, i, (fz_separation_behavior)behavior);
+			}
+		}
+		if (overprint_mode > 0 && !seps)
+			seps = fz_new_separations(ctx, 0);
+	}
+	fz_catch(ctx)
+	{
+		fz_drop_separations(ctx, seps);
+		wasm_rethrow(ctx);
+	}
+	return seps;
+}

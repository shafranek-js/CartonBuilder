+EXPORT
+void wasm_pdf_page_separation_names(pdf_page *page, char *out, int buflen)
+{
+	fz_separations *seps = NULL;
+	fz_try(ctx)
+	{
+		seps = pdf_page_separations(ctx, page);
+		if (seps)
+		{
+			int n = fz_count_separations(ctx, seps);
+			char *p = out;
+			int i;
+			for (i = 0; i < n && p < out + buflen - 1; i++)
+			{
+				const char *name = fz_separation_name(ctx, seps, i);
+				int len = name ? (int)strlen(name) : 0;
+				if (p + len + 1 > out + buflen)
+					break;
+				if (name)
+					memcpy(p, name, len);
+				p += len;
+				*p++ = '\0';
+			}
+			*p = '\0';
+		}
+	}
+	fz_always(ctx)
+	{
+		fz_drop_separations(ctx, seps);
+	}
+	fz_catch(ctx)
+	{
+		wasm_rethrow(ctx);
+	}
+}

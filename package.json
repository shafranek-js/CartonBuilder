{
  "name": "carton-builder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ci": "playwright test",
    "test:visual": "playwright test tests/e2e/render.spec.js -g \"Wave 5 deterministic Render baselines\"",
    "test:all": "npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "gltf-validator": "^2.0.0-dev.3.10",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.34",
    "idb": "^8.0.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "three": "0.185.1"
  }
}

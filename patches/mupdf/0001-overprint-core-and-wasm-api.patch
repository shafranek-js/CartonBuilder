+EXPORT
+fz_pixmap * wasm_convert_pixmap_to_rgb(fz_pixmap *pix)
+{
+	fz_pixmap *out = NULL;
+	fz_var(out);
+	fz_try(ctx)
+	{
+		out = fz_convert_pixmap(ctx, pix, fz_device_rgb(ctx), NULL, NULL, fz_default_color_params, 0);
+	}
+	fz_catch(ctx)
+	{
+		fz_drop_pixmap(ctx, out);
+		wasm_rethrow(ctx);
+	}
+	return out;
+}
